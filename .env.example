# Kopiere diese Datei nach .env und passe sie bei Bedarf an.
# Die Ports sind so gewählt, dass sie nicht mit Project N.O.M.A.D. kollidieren.
PORT_START=8880
PORT_WIKI=8881
# Speicherort für alle Inhalte (Wikis, Videos). Kann auch eine externe Platte sein.
DATEN=./daten
# Maximale Videohöhe beim Herunterladen (480, 720, 1080)
VIDEO_HOEHE=720
